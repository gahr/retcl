# vim: ft=tcl ts=4 sw=4 expandtab:

tcltest::test disconnect-1.1 {disconnect} -constraints {
    serverIsRunning
} -setup {
    set r [retcl new]
} -body {
    $r disconnect
    $r connected
} -cleanup {
    $r destroy
} -result {0}

tcltest::test disconnect-1.2 {reconnect maintains cached results} -constraints {
    serverIsRunning
} -setup {
    set r [retcl new]
} -body {
    set r1 [$r set foo bar]
    set r2 [$r get foo]
    set r3 [$r result $r2]
    $r disconnect
    $r connect
    set r4 [$r result $r2]
    list $r3 $r4
} -cleanup {
    $r flushall
    $r destroy
} -result {bar bar}

tcltest::test disconnect-1.3 {reconnect clears pending results} -constraints {
    serverIsRunning
} -setup {
    set r [retcl new]
} -body {
    set err {}
    proc errorHandler {msg} {
        set ::err $msg
    }
    $r errorHandler errorHandler
    set r1 [$r set foo bar]
    $r disconnect
    $r connect
    $r result $r1
    set r2 [$r set foo bar]
    set r3 [$r result $r2]
    list $err $r2 $r3
} -cleanup {
    $r flushall
    $r destroy
} -result {{Invalid command id: rds:1} rds:2 OK}

tcltest::test disconnect-1.4 {reconnect doesn't leave dangling requests} -constraints {
    serverIsRunning
} -setup {
    set r [retcl new]
} -body {
    set err {}
    proc errorHandler {msg} {
        set ::err $msg
    }
    $r errorHandler errorHandler
    $r disconnect
    $r set foo bar
    $r connect
    set r1 [$r get foo]
    set r2 [$r result $r1]
    list $err $r1 $r2
} -cleanup {
    $r flushall
    $r destroy
} -result {Disconnected rds:1 (nil)}
